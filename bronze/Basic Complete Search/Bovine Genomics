#include <vector>
#include <iostream>
#include <string>
#include <algorithm>
using namespace std;

int main(){
    freopen("cownomics.in", "r", stdin);
    freopen("cownomics.out", "w", stdout);
    int n,m;
    cin>>n>>m;
    int reponse = 0;
    vector<vector<char>> spotty(n, vector<char>(m));
    vector<vector<char>> plain(n, vector<char>(m));
    for(int i = 0; i < n; i++){
        for(int j = 0; j < m; j++){
            cin>>spotty[i][j];
        }
    }
    for(int i = 0; i < n; i++){
        for(int j = 0; j < m; j++){
            cin>>plain[i][j];
        }
    }
    for(int i = 0; i < m; i++){
        bool pareil = true;
        for(int j = 0; j < n; j ++){
            for(int k = 0; k < n; k ++){
                if(spotty[j][i] == plain[k][i]){
                pareil = false;
                break;
            }
            if(!pareil){
                break;
            }
            
            }
        }
        if(pareil){
            reponse +=1;
        }
    }
    cout<<reponse<<"\n";
    return 0;
}
    
