#include <vector>
#include <iostream>
#include <string>
#include <algorithm>
using namespace std;

int main(){
    freopen("lifeguards.in", "r", stdin);
    freopen("lifeguards.out", "w", stdout);
    int n;
    cin>>n;
    vector<int> debut(n);
    vector<int> fin(n);
    int reponse = 0;
    for(int i = 0; i < n; i++){
        cin>>debut[i]>>fin[i];
    }
    for(int i = 0; i < n; i++){
        vector<bool> vue(1000, false);
        for(int j = 0; j < n; j++){
            if(i == j){
                continue;
            }
            for(int k = debut[j]; k < fin[j]; k++){
                    vue[k] = true;
            }
            
        
        }
        int maximum = 0;
        for(int l = 0; l<1000; l++){
                if (vue[l] == true){
                    maximum += 1;
                }
            }
            reponse = max(reponse, maximum);
    }

    cout<<reponse<<"\n";
    return 0;
}
    
