#include <vector>
#include <iostream>
#include <string>
#include <algorithm>
#include <set>
#include <map>
#include <unordered_map>
#include <unordered_set>
using namespace std;




int main(){
    string s;
    cin>>s;
    vector<string> rep;

    sort(s.begin(), s.end());
    do{
        rep.push_back(s);
    }while(next_permutation(s.begin(), s.end()));
    cout << rep.size() <<"\n";
    for(const string& mot: rep){
        cout << mot<<"\n";
    }
    
    return 0;
}
