#include <vector>
#include <iostream>
#include <string>
#include <algorithm>
#include <set>
#include <map>
#include <unordered_map>
#include <unordered_set>
using namespace std;
vector<string> signe(8);
vector<bool> diag1(16, false); 
vector<bool> diag2(16, false);
vector<bool> colonne(8,false);
int rep = 0;
void reine(int index){
    vector<int> placement;
    if(index == 8){
        rep ++;
        return;
    }
    for(int i = 0; i < 8; i++){
        if(signe[index][i] == '*'){continue;}
        if(colonne[i]) continue;
        if(diag1[index + i]) continue;
        if(diag2[index - i + 7]) continue;

        colonne[i] = true;
        diag1[index + i] = true; 
        diag2[index - i + 7] = true;
        reine(index + 1);
        colonne[i] = false;
        diag1[index + i] = false; 
        diag2[index - i + 7] = false;        
    }
}
 


int main(){
    for(int i = 0; i < 8; i++){
        cin>>signe[i];
    }
    reine(0);
    cout <<rep;
   
    
    return 0;
}
