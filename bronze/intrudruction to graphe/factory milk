#include <vector>
#include <iostream>
#include <string>
#include <algorithm>
#include <set>
#include <map>
#include <unordered_map>
#include <unordered_set>
using namespace std;




int main(){
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);   
    freopen("factory.in", "r", stdin);
    freopen("factory.out", "w", stdout);
    int n;
    cin>>n;
    vector<vector<int>> passerelle(n + 1);
    for(int i = 0; i < n -1; i++){
        int un,deux;
        cin>>un>>deux;
        passerelle[un].push_back(deux);
    }
    int rep = 0;
    int nb_erreur = 0;
    for(int i = 1; i < n + 1; i++){
        if(passerelle[i].empty()){
            nb_erreur++;
            rep = i;
        }
        
    }
    if(nb_erreur == 1){
        cout<<rep;
    }else{
        cout<< - 1;
    }
    
    
    
    
    return 0;
}
