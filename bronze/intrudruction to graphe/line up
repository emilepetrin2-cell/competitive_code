#include <vector>
#include <iostream>
#include <string>
#include <algorithm>
#include <set>
#include <map>
#include <unordered_map>
#include <unordered_set>
using namespace std;




int main(){
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);   
    freopen("lineup.in", "r", stdin);
    freopen("lineup.out", "w", stdout);
    vector<string> noms = {"Bessie", "Buttercup", "Belinda", "Beatrice", "Bella", "Blue", "Betsy", "Sue"};
    sort(noms.begin(), noms.end());
    int n;
    cin>>n;
    string mot1,mot2,mot3,mot4,mot5,mot6;
    map<string,vector<string>> nom;
    for(int i = 0; i < n; i++){
        cin>>mot1>>mot2>>mot3>>mot4>>mot5>>mot6;
        nom[mot1].push_back(mot6);
        nom[mot6].push_back(mot1);
    } 
    set<string> vue;   
    vector<string> final;
    for(int i = 0; i < noms.size(); i++){
        string vache = noms[i];
        if(vue.count(vache)){
            continue;
        }
        if(nom[vache].size() <=1 ){
            string courant = vache;
            while(true){
                final.push_back(courant);
                vue.insert(courant);
                string next = "";
                for(string voisin: nom[courant]){
                    if(!vue.count(voisin)){
                        next = voisin;
                        break;
                    }
                }
                if(next == ""){
                    break;
                }
                courant = next;
                
            }


        }
    }
    for(string finale: final){
        cout<<finale<<"\n";
    }
    
    
    
    
    return 0;
}
