#include <set>
#include <map>
#include <unordered_map>
using namespace std;


int main(){
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    int n,x; 
    cin>>n>>x;
    map<int, int> pos;
    for(int i = 1; i < n + 1; i++){
        int nombre;
        cin>>nombre;
        int besoin = x - nombre;
        if (pos.count(besoin)){
            cout << pos[besoin] << " " << i << "\n";
            return 0;
        }
        pos[nombre] = i;
        
    }
    cout << "IMPOSSIBLE\n";

    

    
}
    
