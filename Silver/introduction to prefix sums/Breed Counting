#include <vector>
#include <iostream>
#include <string>
#include <algorithm>
#include <set>
#include <map>
#include <unordered_map>
#include <unordered_set>
using namespace std;



int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    freopen("bcount.in", "r", stdin);
    freopen("bcount.out", "w", stdout);
    int n, q;
    cin>>n>>q;
    vector<int> un(n +1, 0);
    vector<int> deux(n +1, 0);
    vector<int> trois(n +1, 0);
    for(int i = 1; i <= n; i++){
        un[i] = un[i -1 ];
        deux[i] = deux[i -1 ];
        trois[i] = trois[i -1 ];

        int j;
        cin>>j;
        if(j == 1){
            un[i] ++;
        }else if(j == 2){
            deux[i] ++;
        }else{
            trois[i] ++;
        }

    }

    while(q --){
        int l,r;
        cin>>l>>r;
        cout<<un[r] - un[l - 1]<<" ";
        cout<<deux[r] - deux[l - 1]<<" ";
        cout<<trois[r] - trois[l - 1]<<"\n";
    }
    
    

    }

   
