#include <vector>
#include <iostream>
#include <string>
#include <algorithm>
#include <set>
#include <map>
#include <unordered_map>
#include <unordered_set>
using namespace std;



int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    freopen("hps.in", "r", stdin);
    freopen("hps.out", "w", stdout);
    int n;
    cin>>n;
    vector<int> h(n + 1, 0);
    vector<int> p(n + 1, 0);
    vector<int> s(n + 1, 0);
    for(int i = 1; i <= n; i++){
        char c;
        cin>>c;
        h[i] = h[i - 1];
        p[i] = p[i - 1];
        s[i] = s[i - 1];
        if(c == 'H'){
            h[i] ++;
        }else if(c =='P'){
            p[i] ++;
        }else{
            s[i] ++;
        }

    }
    int rep = 0;
    for(int i = 0; i <= n; i++){
        int avant = max({h[i], p[i], s[i]});
        int apres = max({h[n] - h[i], p[n] - p[i], s[n] - s[i]});
        rep = max(rep, avant + apres);

    }
    cout<<rep<<"\n";


    
    

    }

   
