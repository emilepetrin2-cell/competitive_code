void resoudre(vector<int> &nombre, int n){
    map<long long, long long> vue;
    vue[0] = 1;
    long long somme = 0;
    long long rep = 0;
    for(int i = 0; i < nombre.size(); i++){
        somme += nombre[i];
        long long reste = ((somme % n) + n) % n;
        rep += vue[reste];
        vue[reste]++;
    }
    cout << rep<<"\n";
}


