using namespace std;

void resoudre(vector<int> &nombre, int x, int n){
    map<long long, long long> vue;
    long long somme = 0;
    long long rep = 0;
    vue[0] = 1;
    for(int i = 0; i < n; i++){
        somme += nombre[i];
        long long  voulu = somme - x;
        rep += vue[voulu];
        vue[somme] ++;
    }
    cout<<rep<<"\n";
}



int main(){
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int n,x;
    cin>>n>>x;
    vector<int> nombre(n, 0);
    for(int i = 0; i < n; i++){
        cin>>nombre[i];
    }
    resoudre(nombre, x, n);
   
    
   
    

    
    
    return 0;
    }

   
