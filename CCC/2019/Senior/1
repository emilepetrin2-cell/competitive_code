#include <vector>
#include <iostream>
#include <algorithm>
#include <utility>
#include <string>
#include <unordered_map>
using namespace std;




int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    string car;
    cin>>car;
    int h = 0;
    int v = 0;
    for(int i = 0; i < car.size(); i++){
        if(car[i] == 'H') {
            h++;
        }else{
            v++;
        }
    }
    if(h % 2 == 0 && v % 2 == 0){
        cout<<'1'<<" "<<'2'<<"\n"<<'3'<<" "<<'4';
    }else if(h % 2 == 0 && v % 2 == 1){
        cout<<'2'<<" "<<'1'<<"\n"<<'4'<<" "<<'3';
    }else if(h % 2 == 1 && v % 2 == 0){
        cout<<'3'<<" "<<'4'<<"\n"<<'1'<<" "<<'2';
    }else if(h % 2 == 1 && v % 2 == 1){
        cout<<'4'<<" "<<'3'<<"\n"<<'2'<<" "<<'1';
    }
    
    
    
    return 0;
}
