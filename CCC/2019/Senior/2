#include <vector>
#include <iostream>
#include <algorithm>
#include <utility>
#include <string>
#include <unordered_map>
using namespace std;
vector<bool> est_premier;

vector<int> crible(int n) {
    est_premier.assign(n + 1, true);
    vector<int> premiers;

    est_premier[0] = est_premier[1] = false;

    for (int p = 2; p * p <= n; p++) {
        if (est_premier[p]) {
            for (int i = p * p; i <= n; i += p) {
                est_premier[i] = false;
            }
        }
    }

    for (int i = 2; i <= n; i++) {
        if (est_premier[i]) {
            premiers.push_back(i);
        }
    }

    return premiers;
}




int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    vector<int> premier = crible(2000001);
    int n;
    cin>>n;
    vector<int> nombre(n);
    for(int i = 0; i < n; i++){
        cin>>nombre[i];
    }
    for(int i = 0; i < n; i++){
        int cible = 2 * nombre[i];
        for(int a: premier){
            int b = cible - a;
            if(est_premier[b]){
            cout<<a<<" "<<b<<"\n";
            break;
            }
        }
    }



    
    
    return 0;
}