#include <vector>
#include <iostream>
#include <algorithm>
#include <utility>
using namespace std;




int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int n;
    int rep;
    cin>>n;
    for(int i = 0; i * 4 <= n; i++){
        int reste = n - i *4;
        if(reste % 5 == 0){
            rep ++;
        }
    }
    cout<<rep;

    return 0;
}
